# ============================================================
# Copie este arquivo para ".env" (mesma pasta) e preencha os valores.
# NUNCA envie o arquivo ".env" para o GitHub (ele já está no .gitignore).
# ============================================================

# Configurações do Servidor
PORT=3000
NODE_ENV=development
# Endereço do site (frontend). Em produção: https://seu-dominio.com.br (precisa ser https)
FRONTEND_URL=http://localhost:5173

# Quando o site estiver publicado atrás do proxy da hospedagem (Render, Railway, Nginx...),
# deixe 1 (padrão em produção). Se não souber, não mexa. 0 = sem proxy.
# TRUST_PROXY=1

# Banco de Dados MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=defina_a_senha_do_seu_mysql_local
DB_NAME=projetos
# Se o banco ficar numa hospedagem na nuvem que exige conexão criptografada, use true
# DB_SSL=true

# Segredos JWT (dois valores DIFERENTES, longos e aleatórios).
# Para gerar cada um, rode no terminal:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Em produção use valores novos, que ninguém além de você conheça.
JWT_ACCESS_SECRET=cole_aqui_o_primeiro_valor_gerado
JWT_REFRESH_SECRET=cole_aqui_o_segundo_valor_gerado

# Envio de E-mails (Gmail SMTP com Senha de App)
# Em desenvolvimento, se deixar em branco, os links de recuperação aparecem no console do terminal.
# Em produção é obrigatório preencher, senão o e-mail de recuperação não é enviado.
EMAIL_USER=
EMAIL_PASSWORD=
